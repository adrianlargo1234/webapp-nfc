# Supabase — copy to .env.local and fill with your project values
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# ElevenLabs — voz para los vídeos de TikTok (npm run video:tts)
ELEVENLABS_API_KEY=
# Voz de tu Voice Library (opcional; por defecto "Adam")
ELEVENLABS_VOICE_ID=
